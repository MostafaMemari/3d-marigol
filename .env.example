# Copy to `.env.local` (git-ignored) and adjust per environment.
# Every value is optional: an unset or empty value falls back to the default
# baked into src/lib/constants.ts. A bare host works — https:// is added.

# .glb models: {VITE_MODEL_BASE_URL}/{id}.glb
VITE_MODEL_BASE_URL=https://s3.ir-thr-at1.arvanstorage.ir/marigol/models

# Material packages: {VITE_MATERIAL_BASE_URL}/{id}.zip
VITE_MATERIAL_BASE_URL=https://dl.marigol.ir/material

# Where the Download button points: {VITE_PRODUCT_BASE_URL}/?p={id}
VITE_PRODUCT_BASE_URL=https://marigol.ir
