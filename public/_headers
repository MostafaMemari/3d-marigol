# Cloudflare Pages cache headers.
# (GitHub Pages ignores this file; it only affects Cloudflare deployments.)
# Vite emits content-hashed filenames under /assets, safe for immutable caching.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate
